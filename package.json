{
  "name": "nerve",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:check": "NEXT_DIST_DIR=.next-check next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib --ext .ts,.tsx",
    "test": "vitest run",
    "cost:model": "vite-node --config vitest.config.ts scripts/cost-model.ts",
    "grade:calibrate": "vite-node --config vitest.config.ts scripts/grade-calibrate.ts",
    "rep:audition": "vite-node --config vitest.config.ts scripts/rep-audition.ts",
    "grade:collect": "vite-node --config vitest.config.ts scripts/grade-collect.ts",
    "voice:voices": "vite-node --config vitest.config.ts scripts/voice.ts voices",
    "voice:design": "vite-node --config vitest.config.ts scripts/voice.ts design",
    "voice:audition": "vite-node --config vitest.config.ts scripts/voice.ts audition",
    "hero:audio": "vite-node --config vitest.config.ts scripts/hero-audio.ts",
    "shots": "vite-node --config vitest.config.ts scripts/shots.ts",
    "db:seed": "vite-node --config vitest.config.ts scripts/seed-personas.ts",
    "db:content": "vite-node --config vitest.config.ts scripts/seed-content.ts",
    "db:plan": "vite-node --config vitest.config.ts scripts/set-plan.ts",
    "db:types": "npx supabase gen types typescript --project-id \"$SUPABASE_PROJECT_REF\" > /tmp/nerve-db-types.ts && grep -q '^export type Database' /tmp/nerve-db-types.ts && mv /tmp/nerve-db-types.ts lib/db/types.ts || { echo 'db:types failed \u2014 lib/db/types.ts left untouched'; cat /tmp/nerve-db-types.ts; exit 1; }",
    "db:verify": "vite-node --config vitest.config.ts scripts/verify-rls.ts",
    "db:rep": "vite-node --config vitest.config.ts scripts/verify-rep.ts",
    "db:field": "vite-node --config vitest.config.ts scripts/verify-field.ts",
    "db:spend": "vite-node --config vitest.config.ts scripts/verify-spend.ts",
    "db:voice": "vite-node --config vitest.config.ts scripts/verify-voice-budget.ts",
    "db:billing": "vite-node --config vitest.config.ts scripts/verify-billing.ts",
    "legal:pdf": "vite-node --config vitest.config.ts scripts/legal-pdf.ts",
    "brand:assets": "vite-node --config vitest.config.ts scripts/brand-assets.ts",
    "whop:setup": "vite-node --config vitest.config.ts scripts/setup-whop.ts",
    "whop:verify": "vite-node --config vitest.config.ts scripts/verify-whop.ts",
    "whop:probe": "vite-node --config vitest.config.ts scripts/verify-whop-webhook.ts",
    "db:user": "vite-node --config vitest.config.ts scripts/dev-user.ts",
    "db:repair-wins": "vite-node --config vitest.config.ts scripts/repair-wins.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.73.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.23",
    "posthog-js": "^1.422.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "0.180.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.8"
  }
}
