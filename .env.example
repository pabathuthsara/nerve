# OpenAI — needed by both arms. The pipeline arm uses it for transcription and
# for the character model; the realtime arm uses it for everything.
OPENAI_API_KEY=sk-...

# Which adapter the factory returns. 'openai' | 'elevenlabs'
#   openai      gpt-realtime-mini over WebRTC. Native speech-to-speech.
#   elevenlabs  assembled pipeline: our VAD -> STT -> LLM -> ElevenLabs TTS.
VOICE_PROVIDER=openai

# Model for the realtime session. Ignored on the elevenlabs arm.
OPENAI_REALTIME_MODEL=gpt-realtime-mini

# LIVE warmth scoring. Small and cheap on purpose: it moves a meter, it does
# not go on anyone's record. Runs async, off the hot path.
WARMTH_SCORE_MODEL=gpt-4.1-mini

# GRADING. Runs once after the session over the full transcript, with no
# latency budget. Point this at the strongest text model on the account — it is
# roughly 1% of session cost and it is the number the progression record
# depends on.
GRADE_MODEL=gpt-4.1


# ─────────────────────────────────────────────────────────────────────────────
# Dev tooling
#
# The live tuning panel on /rep — every persona layer as a slider, editable
# mid-session, plus presets. Ctrl+Shift+D toggles it; it is collapsed by
# default. Leave this unset anywhere a real user can reach.
#
# Off, the panel never renders and the browser never downloads it (it is a
# separate lazy chunk). The chunk file is still emitted to the build output —
# see lib/tuning/store.ts. It is instrumentation, not a secret.
# ─────────────────────────────────────────────────────────────────────────────

# NEXT_PUBLIC_DEV_TOOLS=true


# ─────────────────────────────────────────────────────────────────────────────
# ElevenLabs pipeline arm
#
# ElevenAPI — raw text-to-speech, billed per character. Deliberately NOT
# ElevenAgents: a managed agent owns turn-taking, and turn-taking is a
# calibrated per-user number (§05). We buy the voice and nothing else.
#
# Everything below is optional except the key. Real values go in .env.local,
# which is gitignored — never in this file.
# ─────────────────────────────────────────────────────────────────────────────

ELEVENLABS_API_KEY=sk_...

# Her voice. Required — the mint refuses without one. Cast it with the CLI, then
# paste the id here or into the persona record (persona.voice.ids.elevenlabs,
# which wins over this):
#   npm run voice:voices                    free; Voice Design needs a paid plan
#   npm run voice:audition -- <voice_id>    ~348 characters per voice
ELEVENLABS_VOICE_ID=

# eleven_flash_v2_5         ~75ms   ultra-low latency
# eleven_v3_conversational  ~280ms  most expressive, reads delivery tags
# Both bill $0.05 per 1,000 characters. The choice is latency vs expressiveness
# and never cost.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Tuning dials. Left unset, stability and speed come off the persona; set here
# they win, so a listening pass does not need a code change.
#   stability   0 lets the voice vary, 1 forces it flat
#   speed       0.7–1.2
# The premade library is tuned for narration and confident delivery. Nadia is
# neither, so expect to push stability up to flatten whoever you cast.
# ELEVENLABS_STABILITY=0.85
# ELEVENLABS_SIMILARITY=0.75
# ELEVENLABS_SPEED=1.0

# Raw PCM only — barge-in needs a sample-accurate playhead, which MP3 frames
# cannot give. pcm_24000 | pcm_22050 | pcm_16000. Drop to 22050 or 16000 if the
# free plan refuses 24k.
# ELEVENLABS_OUTPUT_FORMAT=pcm_24000

# Free plan: 10,000 credits a month, no overage — synthesis simply stops. The
# console screams from WARN_AT upward, in the browser and in the server log.
# ELEVENLABS_CREDIT_BUDGET=10000
# ELEVENLABS_CREDIT_WARN_AT=8000
# Set only if the dashboard's credit count disagrees with our character count.
# ELEVENLABS_CREDITS_PER_CHAR=1

# The other two legs of the pipeline.
# PIPELINE_STT_MODEL=gpt-4o-mini-transcribe
# PIPELINE_LLM_MODEL=gpt-4.1-mini
# PIPELINE_LLM_TEMPERATURE=0.9

# Audition output format for the CLI only. Drop to mp3_22050_32 if the free
# plan refuses the default.
# ELEVENLABS_AUDITION_FORMAT=mp3_44100_128




# ─────────────────────────────────────────────────────────────────────────────
# Supabase (§04) — Postgres + Auth + Storage
#
# Real values go in .env.local, which is gitignored. Placeholders only in here.
#
#   supabase login
#   supabase init
#   supabase link --project-ref <ref>
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co

# Safe in the browser. It is the key RLS is written to constrain.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVER ONLY. Bypasses Row Level Security — the one rule CLAUDE.md marks as
# having no exceptions. Never prefix it NEXT_PUBLIC_, never import it into a
# client component, never reach for it to make a failing query pass.
SUPABASE_SECRET_KEY=sb_secret_...

# Migrations and the CLI only. The app never connects on this.
SUPABASE_PROJECT_REF=<ref>
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<ref>.supabase.co:5432/postgres

# --- Site & scheduled work ---------------------------------------------------

# The origin the OTP email links back to. Optional in development — the auth
# actions fall back to the request host, which is right for localhost and for
# Vercel previews. Set it in production so a link cannot be built from a
# spoofed Host header.
NEXT_PUBLIC_SITE_URL=

# Guards /api/cron/purge-audio, which deletes rep audio past its 30-day
# retention (§05). The route REFUSES TO RUN when this is unset rather than
# running open — an unauthenticated deletion endpoint is worse than audio that
# outlives its window by a day. Vercel Cron sends it as `Bearer <secret>`.
CRON_SECRET=

# Machine credential for harnesses that have no browser session. Currently only
# the opt-in scorer calibration suite, which drives /api/warmth/score over HTTP
# against a running server so it measures the deployed route rather than a
# re-implementation of it.
#
# LEAVE THIS UNSET IN PRODUCTION. Unset means the bypass does not exist; set
# means anyone holding the value can spend model budget without signing in.
INTERNAL_API_SECRET=

# --- Development sign-in ------------------------------------------------------

# Supabase's built-in email sender allows a couple of messages an hour, which is
# fine for a user signing in once and useless for the person building the app.
# Set these and /auth offers a one-click sign-in that never sends an email.
#
#   npm run db:user -- you@example.com
#
# DEVELOPMENT ONLY, and enforced as such: `devSignIn` refuses to run when
# NODE_ENV is production, in the Server Action itself rather than only in the
# component that draws the button. Neither variable is NEXT_PUBLIC_, so neither
# reaches the browser. Leave both empty in any deployed environment.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=

# --- Room acoustics -----------------------------------------------------------

# The procedural reverb and ambient bed are OFF. Convolution placed her in a
# room and, on ordinary laptop speakers, made her harder to understand — which
# is the wrong trade at the exact moment somebody is straining to hear a
# stranger. Recorded room beds arrive as audio files later; they are a
# different mechanism and do not go through this switch.
#
# Set to `on` to hear the procedural room again. Nothing else changes: every
# persona's `room` layer and both scene presets are left exactly as authored.
NEXT_PUBLIC_ROOM_ACOUSTICS=off

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# The project-wide kill switch (B9, §18)
# ---------------------------------------------------------------------------
# Set to `1` to refuse every route that spends money — the grader, the live
# scorer, both pipeline hops and the Realtime token. Nothing else stops: the app
# still loads, history still reads, the field still works.
#
# An environment variable and not a database row on purpose. Stopping the bill
# has to be a dashboard toggle rather than a migration, and it has to still work
# when the reason for stopping is that the database is the problem — this is the
# only one of the three gates that needs no database at all, which is why
# `maySpend` checks it first.
#
# The per-ACCOUNT switch is `entitlements.spend_halted_at`, written by the
# service role. That one needs the database, and is the right tool for one
# runaway user rather than a runaway bill.
NERVE_SPEND_HALT=0

# ---------------------------------------------------------------------------
# ADMIN
#
# Who may open /admin/personas. Comma-separated email addresses, matched
# case-insensitively against the signed-in session.
#
# Not NEXT_PUBLIC_ on purpose: an allowlist in the browser bundle is a list of
# the accounts worth phishing. Not a database column either — revoking access
# has to work when the database is the thing that has gone wrong, which is the
# same argument NERVE_SPEND_HALT makes for itself.
#
# Unset or empty grants NOBODY. The other reading — "unset means everyone" —
# is an open admin panel on a fresh deploy.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Merchant of record — Creem (§14)
# ---------------------------------------------------------------------------
# Not Stripe, and not a choice: Stripe does not operate in Sri Lanka. An MoR is
# also the seller of record, which is what makes selling into 40 countries
# possible without registering for VAT in each of them.
#
# Test and live are told apart by the key's own prefix (`creem_test_` picks the
# sandbox API) rather than by a second variable, because two variables that can
# disagree is a way to point a live key at the sandbox.
CREEM_API_KEY=

# Signs every webhook. `/api/webhooks/creem` REFUSES TO RUN when this is unset
# and returns 503 rather than trusting the body — an unverified billing webhook
# is an endpoint that grants paid plans to anyone who finds the path. The 503 is
# deliberate: Creem retries for six hours, so a missing variable costs a delay
# rather than the events themselves.
#   Dashboard → Developers → Webhooks
CREEM_WEBHOOK_SECRET=

# Which product grants which plan. The ids differ between test and live, which
# is why they are environment and not code — the plans themselves are authored
# in lib/site/plans.ts and reviewed in a pull request.
#
# An unrecognised product grants NOTHING: the webhook records the subscription
# and leaves the plan alone, so a typo here costs a support ticket rather than
# handing out free Elite. Watch the log for "which no CREEM_PRODUCT_* variable
# names" after changing either of these.
CREEM_PRODUCT_PRO=
CREEM_PRODUCT_ELITE=

# Runs a full-dress rehearsal against Creem's SANDBOX on a production
# deployment. Unset everywhere except during that rehearsal.
#
# Production normally refuses a non-live key twice: the buy button is hidden and
# the webhook will not apply an event, because a test key grants real plans for
# payments that never happened and test mode has public hosted payment links.
# This is the deliberate exception, used so the payment flow can be proven on
# the real domain rather than through a tunnel.
#
# While it is set, /profile/subscription tells every visitor that checkout is a
# sandbox and no card is charged, and `npm run creem:verify` refuses to call the
# deployment ready. Remove it in the same edit that installs a live key — see
# docs/PAYMENTS-NEW-INTEGRATION.md §6.5.
CREEM_TEST_MODE_IN_PRODUCTION=
