# OpenAI — the only key M0 needs.
OPENAI_API_KEY=sk-...

# Which adapter the factory returns. 'openai' | 'elevenlabs'
# elevenlabs is a stub at M0 and will throw on connect().
VOICE_PROVIDER=openai

# Model for the realtime session.
OPENAI_REALTIME_MODEL=gpt-realtime-mini

# LIVE warmth scoring. Small and cheap on purpose: it moves a meter, it does
# not go on anyone's record. Runs async, off the hot path.
WARMTH_SCORE_MODEL=gpt-4.1-mini

# GRADING. Runs once after the session over the full transcript, with no
# latency budget. Point this at the strongest text model on the account — it is
# roughly 1% of session cost and it is the number the progression record
# depends on.
GRADE_MODEL=gpt-4.1

# ElevenLabs — not needed until the adapter is filled in before M3.
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
